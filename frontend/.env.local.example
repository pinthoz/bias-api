# Only for `npm run dev`. The deployed site calls /predict on its own domain.
# Use the CloudFront URL (terraform -chdir=../infra output -raw site_url) + /predict:
# the API allows CORS (content-type + x-api-key) from http://localhost:3000.
# The API key itself is typed into the page, not set here.
NEXT_PUBLIC_API_URL=https://xxxxxxxxxxxxxx.cloudfront.net/predict
